# --- LLM provider: groq | openrouter | ollama | anthropic ---
LLM_PROVIDER=groq

# Groq (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models end in ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Anthropic (paid credits)
ANTHROPIC_API_KEY=
# Ollama (local, no key)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model per stage. Model IDs change — check your provider's model list.
# Groq:        llama-3.3-70b-versatile  (strong)   llama-3.1-8b-instant (fast)
# OpenRouter:  meta-llama/llama-3.3-70b-instruct:free   (pick a free model that supports tools)
# Ollama:      qwen3:8b  /  llama3.1:8b
SPECWRIGHT_MODEL_EXTRACT=llama-3.3-70b-versatile
SPECWRIGHT_MODEL_PLAN=llama-3.3-70b-versatile
SPECWRIGHT_MODEL_REVIEW=llama-3.3-70b-versatile

# --- Other services ---
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

REDIS_URL=redis://localhost:6379
LINEAR_API_KEY=
WEB_ORIGIN=http://localhost:3000